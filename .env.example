# Firebase Web App credentials (Project settings > General > Your apps)
# Copy this file to .env.local and fill in the values.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Yes, PORJECT is a typo. It is the name the code reads in src/firebase/config.js;
# keep both sides aligned or rename them together.
NEXT_PUBLIC_FIREBASE_PORJECT_ID=
